# Cartzilla frontend environment.
# In dev, Vite proxies /api -> VITE_API_TARGET (default http://localhost:8080).
VITE_API_TARGET=http://localhost:8080

# For a production build where the API is on a different origin, set the absolute
# base (the app appends /api). Leave empty in dev to use the Vite proxy.
# VITE_API_BASE_URL=https://api.cartzilla.example
