# Copy this file to .env and adjust values for local demo only.
DB_PASSWORD=secret
JWT_SECRET=dev-secret-key-change-me-please-32bytes!!

# Set true to demo Saga rollback: payment-service always fails.
ALWAYS_FAIL=false

# Host ports for database demo from your machine (mỗi DB một port riêng để tránh đụng nhau).
USER_DB_PORT=5432
PRODUCT_DB_PORT=5433
ORDER_DB_PORT=5434
PAYMENT_DB_PORT=5435
NOTIF_DB_PORT=5436

# Direct service ports khi chạy bằng Docker Compose.
USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
